{
  "name": "hatm-smm",
  "version": "1.0.0",
  "description": "HATM - SMM Panel",
  "type": "module",

  "engines": {
    "node": ">=20.19.0"
  },

  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite --config client/vite.config.ts",

    "build": "npm run build:client && npm run build:server",

    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",

    "start": "node dist/server.js"
  },

  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.0",
    "express": "^5.1.0",
    "iron-session": "^8.0.4",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.19",
    "zod": "^3.24.3",
"wouter": "^3.3.5",
    "recharts": "^2.12.7",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.21",
    "@vitejs/plugin-react": "^4.4.1"
  },

  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0-dev.20250501",
    "drizzle-kit": "^0.30.5"
  }
}

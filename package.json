{
  "name": "hatm-smm",
  "version": "1.0.0",
  "description": "HATM - Arabic/English SMM Panel",
  "type": "module",

  "engines": {
    "node": ">=20.19.0"
  },

  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "vite --config client/vite.config.ts",

    "build": "npm install --include=dev && npm run build:client && npm run build:server",

    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",

    "start": "node dist/server.js",

    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },

  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.0",
    "express": "^5.1.0",
    "iron-session": "^8.0.4",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-http": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.3"
  },

  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.11.13",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.5",
    "tailwindcss": "^4.1.6",
    "tsx": "^4.19.4",
    "typescript": "^5.9.0-dev.20250501",
    "vite": "^5.4.19"
  }
}
